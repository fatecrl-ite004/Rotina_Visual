# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

cat > .gitignore << 'EOF'
# Flutter/Dart
.dart_tool/
.pub/
.pub-cache/
.packages
build/
flutter_*.png
*.iml
*.lock
*.log
*.a
*.app
*.dll
*.exe
*.pdb
*.so

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Android
android/local.properties
android/app/.settings/
android/app/.project
android/app/.classpath

# iOS
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Podfile.lock
ios/Pods/
ios/.symlinks/

# Mac
**/DerivedData/

# Testes
coverage/
*.gcno
*.gcda
*.gcov

# Keys
*.key
*.p12
EOF